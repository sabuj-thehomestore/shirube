# Database connection URL (PostgreSQL or MySQL)
DATABASE_URL=postgresql://shirube:shirube@localhost:5432/shirube

# Secret string used to verify tokens and salt hashes
APP_SECRET=your-random-secret-key

# Optional: Disable telemetry pinging upstream
DISABLE_TELEMETRY=1

# Optional: Required for two-factor authentication (64 character hex string)
# TWO_FACTOR_ENCRYPTION_KEY=

# Optional: Port to run on (default 3000)
# PORT=3000
